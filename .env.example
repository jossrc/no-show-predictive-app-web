# ENV
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# POSTGRESQL (requerido)
DB_HOST_POSTGRES=localhost
DB_PORT_POSTGRES=5432
DB_USER_POSTGRES=admin
DB_PASS_POSTGRES=admin
DB_NAME_POSTGRES=depi-noshow-db

# MYSQL 5 FLOWww (opcional)
DB_HOST_MYSQL=
DB_PORT_MYSQL=3306
DB_USER_MYSQL=
DB_PASS_MYSQL=
DB_NAME_MYSQL=

# --- Sprint 01: API predictiva (HU-01/02/03/05/06) ---
# Rutas de negocio /api/v1/*. En production se rechazan hasta implementar HU-21/HU-22.
PREDICTIVE_API_ENABLED=true
# SHA-256 (hex, 64 caracteres) de la credencial interna provisional (>=32 caracteres).
# La credencial en claro NUNCA se guarda aquí ni se envía al navegador; solo la usa un
# servidor (p. ej. Next.js server-side) en la cabecera x-api-key. Sin este valor, las
# rutas de negocio no se registran. Generar con:
#   node -e "const k=require('crypto').randomBytes(32).toString('base64url');console.log('KEY='+k);console.log('SHA256='+require('crypto').createHash('sha256').update(k).digest('hex'))"
INTERNAL_API_KEY_SHA256=
# READ_ONLY_EXISTING_SCHEDULE (raw_flow/analytics reales) | SYNTHETIC_DEMO_ONLY (solo BD de prueba)
DATA_SOURCE_MODE=READ_ONLY_EXISTING_SCHEDULE

# Microservicio Python depi-noshow-ml (solo backend a backend; nunca exponer la clave)
ML_SERVICE_URL=http://127.0.0.1:8001
# Misma clave que ML_API_SERVICE_KEY del servicio Python (32-512 caracteres ASCII).
ML_SERVICE_KEY=
# Hosts adicionales permitidos además de loopback (lista separada por comas, opcional)
ML_SERVICE_ALLOWED_HOSTS=
ML_HTTP_TIMEOUT_MS=5000
ML_EXPLAIN_TIMEOUT_MS=10000
ML_MAX_CONCURRENT_REQUESTS=2
ML_MAX_CONCURRENT_EXPLANATIONS=1
ML_MAX_QUEUED_REQUESTS=8
ML_BATCH_MAX_ITEMS=32
ML_CIRCUIT_FAILURE_THRESHOLD=5
ML_CIRCUIT_COOLDOWN_MS=30000
ML_MODEL_CATALOG_TTL_MS=60000
