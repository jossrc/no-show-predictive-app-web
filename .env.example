# ENV
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# POSTGRESQL (requerido)
DB_HOST_POSTGRES=localhost
DB_PORT_POSTGRES=5432
DB_USER_POSTGRES=admin
DB_PASS_POSTGRES=admin
DB_NAME_POSTGRES=depi-noshow-db

# MYSQL 5 FLOWww (opcional)
DB_HOST_MYSQL=
DB_PORT_MYSQL=3306
DB_USER_MYSQL=
DB_PASS_MYSQL=
DB_NAME_MYSQL=

# --- Sprint 01: API predictiva (HU-01/02/03/05/06) ---
# Rutas de negocio /api/v1/*. En production se rechazan hasta implementar HU-21/HU-22.
PREDICTIVE_API_ENABLED=true
# SHA-256 (hex, 64 caracteres) de la credencial interna provisional (>=32 caracteres).
# La credencial en claro NUNCA se guarda aquí ni se envía al navegador; solo la usa un
# servidor (p. ej. Next.js server-side) en la cabecera x-api-key. Sin este valor, las
# rutas de negocio no se registran. Generar con:
#   node -e "const k=require('crypto').randomBytes(32).toString('base64url');console.log('KEY='+k);console.log('SHA256='+require('crypto').createHash('sha256').update(k).digest('hex'))"
INTERNAL_API_KEY_SHA256=
# READ_ONLY_EXISTING_SCHEDULE: reservas/evidencia/historial reales desde PostgreSQL en SOLO LECTURA.
# SYNTHETIC_DEMO_ONLY: dataset sintético versionado, sin lecturas de negocio a PostgreSQL (prohibido en production).
DATA_SOURCE_MODE=READ_ONLY_EXISTING_SCHEDULE

# Almacén predictivo PostgreSQL PROPIO de la app (ADR-008): conexión SEPARADA de la fuente DB_*.
# Rol runtime restringido (SELECT/INSERT en ml.app_*), creado por
# migrations/postgres/predictive_app/provisioning/roles.sql. Obligatorio si las rutas de negocio
# están habilitadas (sin fallback a SQLite ni memoria). La base debe estar migrada
# (npm run store:migrate) y ligada al DATA_SOURCE_MODE activo.
APP_DB_HOST_POSTGRES=localhost
APP_DB_PORT_POSTGRES=5432
APP_DB_NAME_POSTGRES=depi-noshow-db
APP_DB_USER_POSTGRES=noshow_app_runtime
APP_DB_PASS_POSTGRES=
APP_DB_STATEMENT_TIMEOUT_MS=5000
# Solo desarrollo local SIN roles aprovisionados (rechazado en production; health ⇒ restrictedRole=false).
APP_DB_ALLOW_PRIVILEGED_ROLE=false
# Rol MIGRADOR: solo para npm run store:migrate (no lo usa el proceso runtime).
# APP_DB_MIGRATOR_USER_POSTGRES=noshow_app_migrator
# APP_DB_MIGRATOR_PASS_POSTGRES=

# Microservicio Python depi-noshow-ml (solo backend a backend; nunca exponer la clave)
ML_SERVICE_URL=http://127.0.0.1:8001
# Misma clave que ML_API_SERVICE_KEY del servicio Python (32-512 caracteres ASCII).
ML_SERVICE_KEY=
# Hosts adicionales permitidos además de loopback (lista separada por comas, opcional)
ML_SERVICE_ALLOWED_HOSTS=
ML_HTTP_TIMEOUT_MS=5000
ML_EXPLAIN_TIMEOUT_MS=10000
ML_MAX_CONCURRENT_REQUESTS=2
ML_MAX_CONCURRENT_EXPLANATIONS=1
ML_MAX_QUEUED_REQUESTS=8
ML_BATCH_MAX_ITEMS=32
ML_CIRCUIT_FAILURE_THRESHOLD=5
ML_CIRCUIT_COOLDOWN_MS=30000
ML_MODEL_CATALOG_TTL_MS=60000
# Bandas EXPERIMENTALES research v2 (research_risk_v1_1). true: el POST exige la política v2 disponible
# (si no, 503 RESEARCH_RISK_POLICY_NOT_READY; nunca LOW ni score sin banda). false: inferencia v1 sin banda.
ML_RESEARCH_RISK_ENABLED=true
# Allowlist opcional de hashes de política research (SHA-256 separados por coma). Vacío = la publicada por Python.
# Hashes publicados por Python para research_risk_v1_1 (no son secretos):
#   RF 1d58ce962e899b758275f7191244225e8c970cf2db9661ffcb21be9b63a4ce74
#   XGB 208c706d839b7c8b71134cd225da4bc1bb935c5d4bd06cbb898a8d8f84ee7032
ML_RESEARCH_EXPECTED_POLICY_HASHES=

# Incorporación masiva de reservas (POST /api/v1/reservation-imports, CSV/XLSX en memoria)
# Tamaño máximo del archivo en bytes (por defecto 5 MiB; máximo 20 MiB) y filas por lote (máx. 20000).
RESERVATION_IMPORT_MAX_FILE_BYTES=5242880
RESERVATION_IMPORT_MAX_ROWS=5000

# Escrituras de esquema/datos fuera del runtime: BLOQUEADAS. Solo con autorización expresa del propietario.
# PREDICTIVE_STORE_MIGRATION_AUTHORIZED=true   (npm run store:migrate sin --dry-run; solo CREATE ml.app_*)
# PREDICTIVE_STORE_IMPORT_AUTHORIZED=true      (npm run store:import-legacy; importa histórico SQLite)
# ML_SCHEMA_WRITE_AUTHORIZED=true   (OBSOLETO: npm run migrate:app, runner heredado v1 con down)
# FLOW_MIGRATION_WRITE_AUTHORIZED=true   (npm run migrate:flow)
